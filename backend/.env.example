# ============================================================
# QuickHire Django Backend - Environment Configuration
# ============================================================

# Django
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# ============================================================
# DATABASE: Supabase (PostgreSQL)
# Find these in Supabase Dashboard → Project Settings → Database
# ============================================================

# Option A: Individual fields (recommended for Django ORM)
DB_ENGINE=django.db.backends.postgresql
DB_HOST=db.YOUR_PROJECT_REF.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Option B: Supabase credentials (for direct supabase-py client calls)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ============================================================
# Celery / Redis (optional)
# ============================================================
CELERY_BROKER_URL=redis://localhost:6379/0

# ============================================================
# AI Pipeline (optional overrides)
# ============================================================
TESSERACT_CMD=
OCR_MIN_CONFIDENCE=0.75
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SEMANTIC_WEIGHT=0.6
SKILL_WEIGHT=0.4
REQUIRED_SKILL_PORTION=0.7
PREFERRED_SKILL_PORTION=0.3

# ============================================================
# External APIs
# ============================================================
GEMINI_API_KEY=
